<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>REJA</title>
    <link
      rel="stylesheet"
      href="https://stackpath.bootstrapcdn.com/bootstrap/4.2.1/css/bootstrap.min.css"
      integrity="sha384-GJzZqFGwb1QTTN6wy59ffF1BuGJpLSa9DkKMp0DgiMDm4iYMj70gZWKYbI706tWS"
      crossorigin="anonymous"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <style>
      * {
        box-sizing: border-box;
      }

      body {
        background: #0c1210;
        font-family: "Poppins", sans-serif;
        min-height: 100vh;
        padding-bottom: 60px;
      }

      .container {
        max-width: 720px;
      }

      h1.display-4 {
        font-weight: 800;
        color: #f2f5f3;
        letter-spacing: 1px;
        margin-top: 52px;
        margin-bottom: 36px;
        text-align: left !important;
        font-size: 2.6rem;
        line-height: 1.15;
        border-bottom: 1px solid #253430;
        padding-bottom: 28px;
      }

      .jumbotron {
        background: #121a17 !important;
        border-radius: 14px;
        box-shadow: none;
        border: 1px solid #23302b;
      }

      #create-field {
        background: #0c1210;
        border-radius: 10px;
        border: 1px solid #263631;
        color: #e6ece9;
        padding: 13px 18px;
        font-size: 0.98rem;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
      }

      #create-field::placeholder {
        color: #5b6b64;
      }

      #create-field:focus {
        background: #0c1210;
        border-color: #2ee6a6;
        box-shadow: 0 0 0 3px rgba(46, 230, 166, 0.14);
        outline: none;
        color: #e6ece9;
      }

      #create-form .btn-primary {
        background: transparent;
        border: 1px solid #2ee6a6;
        color: #2ee6a6;
        padding: 12px 26px;
        font-weight: 600;
        letter-spacing: 0.3px;
        border-radius: 999px;
        transition: all 0.2s ease;
      }

      #create-form .btn-primary:hover {
        background: #2ee6a6;
        color: #0c1210;
        box-shadow: 0 6px 18px rgba(46, 230, 166, 0.25);
      }

      #item-list {
        border-radius: 14px;
        overflow: hidden;
        box-shadow: none;
        border: 1px solid #23302b;
      }

      #item-list .list-group-item {
        background-color: #121a17 !important;
        border: none;
        border-bottom: 1px solid #202d28;
        padding: 20px 24px;
        transition: background-color 0.2s ease;
        position: relative;
      }

      #item-list .list-group-item::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 3px;
        background: #2ee6a6;
        opacity: 0;
        transition: opacity 0.2s ease;
      }

      #item-list .list-group-item:last-child {
        border-bottom: none;
      }

      #item-list .list-group-item:hover {
        background-color: #16211c !important;
      }

      #item-list .list-group-item:hover::before {
        opacity: 1;
      }

      .item-text {
        font-size: 1.02rem;
        font-weight: 400;
        color: #d7ded9;
        padding-left: 6px;
      }

      .edit-me,
      .delete-me {
        border-radius: 999px;
        font-weight: 600;
        font-size: 0.78rem;
        padding: 7px 16px;
        border: 1px solid transparent;
        letter-spacing: 0.3px;
        transition: all 0.18s ease;
      }

      .edit-me {
        background-color: transparent;
        border-color: #33453e;
        color: #9fb0a8;
      }

      .edit-me:hover {
        border-color: #2ee6a6;
        color: #2ee6a6;
      }

      .delete-me {
        background-color: transparent;
        border-color: #452e2e;
        color: #d97a7a;
      }

      .delete-me:hover {
        border-color: #e6564a;
        color: #ff8478;
      }

      button[style*="border-radius: 20px"]:not(.btn-primary) {
        display: block;
        margin: 34px auto 0;
        background: transparent;
        color: #6c7a74;
        border: 1px solid #263631 !important;
        padding: 10px 24px;
        font-weight: 500;
        letter-spacing: 0.3px;
        border-radius: 999px !important;
        transition: all 0.2s ease;
      }

      button[style*="border-radius: 20px"]:not(.btn-primary):hover {
        border-color: #e6564a !important;
        color: #ff8478;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <h1 class="display-4 text-center py-1">REJA VA MAQSADLAR</h1>
      <div class="jumbotron p-3 shadow-sm">
        <form id="create-form" action="/create-item" method="POST">
          <div class="d-flex align-items-center">
            <input
              id="create-field"
              name="reja"
              autofocus
              autocomplete="off"
                class="form-control mr-3"
                type="text"
                style="flex: 1"
              />
              <button class="btn btn-primary" style="border-radius: 20px">
                Yangi Reja Qoshish
              </button>
            </div>
          </form>
        </div>
      <ul id="item-list" class="list-group pb-5">

           <% items.map(function(item){ %>
             <li
          class="list-group-item list-group-item-info d-flex align-items-center justify-content-between"
        >
          <span class="item-text"><%=item.reja%></span>
          <div>
            <button data-id="<%=item._id%>" class="edit-me btn btn-secondary btn-sm mr-1">
              Ozgartirish
            </button>
            <button data-id="<%=item._id%>"  class="delete-me btn btn-danger btn-sm"> Ochirish </button>
          </div>
        </li>
          <% })%>
      </ul>
     <button id="clean-all" style="border-radius: 20px">Hamma Rejalarni Ochirish</button>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="/browser.js"></script>
  </body>
  </html>
