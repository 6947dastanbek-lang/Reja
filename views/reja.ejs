<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>REJA</title>
    <link
      rel="stylesheet"
      href="https://stackpath.bootstrapcdn.com/bootstrap/4.2.1/css/bootstrap.min.css"
      integrity="sha384-GJzZqFGwb1QTTN6wy59ffF1BuGJpLSa9DkKMp0DgiMDm4iYMj70gZWKYbI706tWS"
      crossorigin="anonymous"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      body {
        background: linear-gradient(135deg, #eef4ff 0%, #f7fbff 100%);
        font-family: "Poppins", sans-serif;
        min-height: 100vh;
        padding-bottom: 60px;
      }

      .container {
        max-width: 720px;
      }

      h1.display-4 {
        font-weight: 700;
        color: #2b3a67;
        letter-spacing: 1px;
        margin-top: 40px;
        margin-bottom: 30px;
        text-shadow: 0 2px 10px rgba(43, 58, 103, 0.1);
      }

      .jumbotron {
        background: #ffffff !important;
        border-radius: 18px;
        box-shadow: 0 8px 24px rgba(43, 58, 103, 0.08);
        border: none;
      }

      #create-field {
        border-radius: 12px;
        border: 2px solid #e3e9f5;
        padding: 12px 16px;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
      }

      #create-field:focus {
        border-color: #4a6cf7;
        box-shadow: 0 0 0 3px rgba(74, 108, 247, 0.15);
        outline: none;
      }

      #create-form .btn-primary {
        background: linear-gradient(135deg, #4a6cf7, #6c8bff);
        border: none;
        padding: 12px 26px;
        font-weight: 600;
        box-shadow: 0 4px 14px rgba(74, 108, 247, 0.35);
        transition: transform 0.15s ease, box-shadow 0.15s ease;
      }

      #create-form .btn-primary:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 18px rgba(74, 108, 247, 0.45);
      }

      #item-list {
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 24px rgba(43, 58, 103, 0.08);
      }

      #item-list .list-group-item {
        background-color: #ffffff !important;
        border: none;
        border-bottom: 1px solid #eef1f8;
        padding: 18px 22px;
        transition: background-color 0.15s ease;
      }

      #item-list .list-group-item:last-child {
        border-bottom: none;
      }

      #item-list .list-group-item:hover {
        background-color: #dadee7 !important;
      }

      .item-text {
        font-size: 1.05rem;
        font-weight: 500;
        color: #2b3a67;
      }

      .edit-me,
      .delete-me {
        border-radius: 8px;
        font-weight: 500;
        font-size: 0.85rem;
        padding: 6px 14px;
        border: none;
        transition: transform 0.15s ease, opacity 0.15s ease;
      }

      .edit-me {
        background-color: #eef1f8;
        color: #4a5578;
      }

      .edit-me:hover {
        background-color: #1141c6;
        transform: translateY(-1px);
      }

      .delete-me {
        background-color: #ffe3e3;
        color: #d64545;
      }

      .delete-me:hover {
        background-color: #9d2a2a;
        transform: translateY(-1px);
      }

      button[style*="border-radius: 20px"]:not(.btn-primary) {
        display: block;
        margin: 30px auto 0;
        background: #ffffff;
        color: #6c7690;
        border: 2px solid #e3e9f5 !important;
        padding: 10px 24px;
        font-weight: 500;
        transition: all 0.15s ease;
      }

      button[style*="border-radius: 20px"]:not(.btn-primary):hover {
        background: #fff0f0;
        color: #d64545;
        border-color: #ffcccc !important;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <h1 class="display-4 text-center py-1">REJA VA MAQSADLAR</h1>

      <div class="jumbotron p-3 shadow-sm">
        <form id="create-form" action="/create-item" method="POST">
          <div class="d-flex align-items-center">
            <input
              id="create-field"
              name="reja"
              autofocus
              autocomplete="off"
                class="form-control mr-3"
                type="text"
                style="flex: 1"
              />
              <button class="btn btn-primary" style="border-radius: 20px">
                Yangi Reja Qoshish
              </button>
            </div>
          </form>
        </div>

      <ul id="item-list" class="list-group pb-5">

           <% items.map(function(item){ %>
             <li
          class="list-group-item list-group-item-info d-flex align-items-center justify-content-between"
        >
          <span class="item-text"><%=item.reja%></span>
          <div>
            <button data-id="<%=item._id%>" class="edit-me btn btn-secondary btn-sm mr-1">
              Ozgartirish
            </button>
            <button data-id="<%=item._id%>"  class="delete-me btn btn-danger btn-sm"> Ochirish </button>
          </div>
        </li>
          <% })%>

      </ul>
     <button id="clean-all" style="border-radius: 20px">Hamma Rejalarni Ochirish</button>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="/browser.js"></script>
  </body>
  </html>
