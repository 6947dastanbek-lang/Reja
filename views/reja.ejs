<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>REJA</title>
    <link
      rel="stylesheet"
      href="https://stackpath.bootstrapcdn.com/bootstrap/4.2.1/css/bootstrap.min.css"
      integrity="sha384-GJzZqFGwb1QTTN6wy59ffF1BuGJpLSa9DkKMp0DgiMDm4iYMj70gZWKYbI706tWS"
      crossorigin="anonymous"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <style>
      * {
        box-sizing: border-box;
      }

      body {
        background: radial-gradient(circle at top left, #eef4ff 0%, #f7fbff 45%, #eef2ff 100%);
        font-family: "Poppins", sans-serif;
        min-height: 100vh;
        padding-bottom: 60px;
      }

      .container {
        max-width: 720px;
      }

      h1.display-4 {
        font-weight: 800;
        color: #2b3a67;
        letter-spacing: 1.5px;
        margin-top: 48px;
        margin-bottom: 34px;
        text-shadow: 0 4px 16px rgba(43, 58, 103, 0.12);
        background: linear-gradient(135deg, #2b3a67, #4a6cf7);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .jumbotron {
        background: #ffffff !important;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(43, 58, 103, 0.1);
        border: 1px solid rgba(74, 108, 247, 0.06);
        transition: box-shadow 0.25s ease;
      }

      .jumbotron:hover {
        box-shadow: 0 14px 36px rgba(43, 58, 103, 0.14);
      }

      #create-field {
        border-radius: 12px;
        border: 2px solid #e3e9f5;
        padding: 13px 18px;
        font-size: 0.98rem;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
      }

      #create-field::placeholder {
        color: #b3bcd6;
      }

      #create-field:focus {
        border-color: #4a6cf7;
        box-shadow: 0 0 0 4px rgba(74, 108, 247, 0.14);
        outline: none;
      }

      #create-form .btn-primary {
        background: linear-gradient(135deg, #4a6cf7, #7b93ff);
        border: none;
        padding: 13px 28px;
        font-weight: 600;
        letter-spacing: 0.3px;
        box-shadow: 0 6px 18px rgba(74, 108, 247, 0.38);
        transition: transform 0.18s ease, box-shadow 0.18s ease;
      }

      #create-form .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 24px rgba(74, 108, 247, 0.48);
      }

      #create-form .btn-primary:active {
        transform: translateY(0);
      }

      #item-list {
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(43, 58, 103, 0.1);
        border: 1px solid rgba(43, 58, 103, 0.05);
      }

      #item-list .list-group-item {
        background-color: #ffffff !important;
        border: none;
        border-bottom: 1px solid #eef1f8;
        padding: 20px 24px;
        transition: background-color 0.2s ease, transform 0.15s ease;
        position: relative;
      }

      #item-list .list-group-item::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 4px;
        background: linear-gradient(180deg, #4a6cf7, #7b93ff);
        opacity: 0;
        transition: opacity 0.2s ease;
      }

      #item-list .list-group-item:last-child {
        border-bottom: none;
      }

      #item-list .list-group-item:hover {
        background-color: #f4f7ff !important;
      }

      #item-list .list-group-item:hover::before {
        opacity: 1;
      }

      .item-text {
        font-size: 1.05rem;
        font-weight: 500;
        color: #2b3a67;
        padding-left: 6px;
      }

      .edit-me,
      .delete-me {
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.82rem;
        padding: 7px 16px;
        border: none;
        letter-spacing: 0.2px;
        transition: all 0.18s ease;
      }

      .edit-me {
        background-color: #eef1f8;
        color: #4a5578;
      }

      .edit-me:hover {
        background: linear-gradient(135deg, #4a6cf7, #6c8bff);
        color: #ffffff;
        transform: translateY(-2px);
        box-shadow: 0 6px 14px rgba(74, 108, 247, 0.35);
      }

      .delete-me {
        background-color: #ffe3e3;
        color: #d64545;
      }

      .delete-me:hover {
        background: linear-gradient(135deg, #e64545, #c62d2d);
        color: #ffffff;
        transform: translateY(-2px);
        box-shadow: 0 6px 14px rgba(214, 69, 69, 0.35);
      }

      button[style*="border-radius: 20px"]:not(.btn-primary) {
        display: block;
        margin: 34px auto 0;
        background: #ffffff;
        color: #6c7690;
        border: 2px solid #e3e9f5 !important;
        padding: 11px 26px;
        font-weight: 600;
        letter-spacing: 0.3px;
        box-shadow: 0 4px 14px rgba(43, 58, 103, 0.06);
        transition: all 0.2s ease;
      }

      button[style*="border-radius: 20px"]:not(.btn-primary):hover {
        background: linear-gradient(135deg, #ff6b6b, #d64545);
        color: #ffffff;
        border-color: transparent !important;
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(214, 69, 69, 0.3);
      }
    </style>
  </head>
  <body>
    <div class="container">
      <h1 class="display-4 text-center py-1">REJA VA MAQSADLAR</h1>
      <div class="jumbotron p-3 shadow-sm">
        <form id="create-form" action="/create-item" method="POST">
          <div class="d-flex align-items-center">
            <input
              id="create-field"
              name="reja"
              autofocus
              autocomplete="off"
                class="form-control mr-3"
                type="text"
                style="flex: 1"
              />
              <button class="btn btn-primary" style="border-radius: 20px">
                Yangi Reja Qoshish
              </button>
            </div>
          </form>
        </div>
      <ul id="item-list" class="list-group pb-5">

           <% items.map(function(item){ %>
             <li
          class="list-group-item list-group-item-info d-flex align-items-center justify-content-between"
        >
          <span class="item-text"><%=item.reja%></span>
          <div>
            <button data-id="<%=item._id%>" class="edit-me btn btn-secondary btn-sm mr-1">
              Ozgartirish
            </button>
            <button data-id="<%=item._id%>"  class="delete-me btn btn-danger btn-sm"> Ochirish </button>
          </div>
        </li>
          <% })%>
      </ul>
     <button id="clean-all" style="border-radius: 20px">Hamma Rejalarni Ochirish</button>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="/browser.js"></script>
  </body>
  </html>
